{
  "base-color": "oklch(0.62 0.21 264.376)",
  "radius": "0.625rem",

  "palette-50": "oklch(from var(--base-color) calc(l + 0.24) calc(c * 0.22) h)",
  "palette-100": "oklch(from var(--base-color) calc(l + 0.18) calc(c * 0.28) h)",
  "palette-200": "oklch(from var(--base-color) calc(l + 0.12) calc(c * 0.4) h)",
  "palette-300": "oklch(from var(--base-color) calc(l + 0.06) calc(c * 0.6) h)",
  "palette-400": "oklch(from var(--base-color) calc(l - 0.02) calc(c * 0.8) h)",
  "palette-500": "oklch(from var(--base-color) calc(l - 0.08) calc(c * 0.72) h)",
  "palette-600": "oklch(from var(--base-color) calc(l - 0.14) calc(c * 0.64) h)",
  "palette-700": "oklch(from var(--base-color) calc(l - 0.2) calc(c * 0.58) h)",
  "palette-800": "oklch(from var(--base-color) calc(l - 0.26) calc(c * 0.52) h)",
  "palette-900": "oklch(from var(--base-color) calc(l - 0.32) calc(c * 0.46) h)",
  "palette-950": "oklch(from var(--base-color) calc(l - 0.38) calc(c * 0.4) h)",

  "background": "var(--palette-950)",
  "foreground": "var(--palette-50)",
  "card": "var(--palette-900)",
  "card-foreground": "var(--palette-50)",
  "popover": "var(--palette-900)",
  "popover-foreground": "var(--palette-50)",
  "primary": "var(--palette-300)",
  "primary-foreground": "var(--palette-950)",
  "secondary": "var(--palette-800)",
  "secondary-foreground": "var(--palette-100)",
  "muted": "var(--palette-800)",
  "muted-foreground": "var(--palette-400)",
  "accent": "var(--palette-700)",
  "accent-foreground": "var(--palette-100)",
  "destructive": "oklch(from var(--palette-400) l c calc(h - 120))",
  "destructive-foreground": "var(--palette-950)",
  "warning": "oklch(from var(--palette-400) l c calc(h - 70))",
  "warning-foreground": "var(--palette-950)",
  "success": "oklch(from var(--palette-400) l c calc(h + 110))",
  "success-foreground": "var(--palette-950)",
  "info": "oklch(from var(--palette-400) l c calc(h + 25))",
  "info-foreground": "var(--palette-950)",
  "brand": "var(--palette-400)",
  "brand-foreground": "var(--palette-950)",
  "border": "var(--palette-800)",
  "input": "var(--palette-700)",
  "ring": "var(--palette-400)",
  "chart-1": "var(--primary)",
  "chart-2": "var(--info)",
  "chart-3": "var(--success)",
  "chart-4": "var(--warning)",
  "chart-5": "var(--destructive)",
  "sidebar": "var(--palette-900)",
  "sidebar-foreground": "var(--palette-50)",
  "sidebar-primary": "var(--palette-300)",
  "sidebar-primary-foreground": "var(--palette-950)",
  "sidebar-accent": "var(--palette-800)",
  "sidebar-accent-foreground": "var(--palette-100)",
  "sidebar-border": "var(--palette-800)",
  "sidebar-ring": "var(--palette-400)"
}
