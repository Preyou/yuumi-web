{
  "base-color": "oklch(0.62 0.21 264.376)",
  "radius": "0.625rem",

  "palette-50": "oklch(from var(--base-color) calc(l + 0.36) calc(c * 0.14) h)",
  "palette-100": "oklch(from var(--base-color) calc(l + 0.3) calc(c * 0.2) h)",
  "palette-200": "oklch(from var(--base-color) calc(l + 0.22) calc(c * 0.32) h)",
  "palette-300": "oklch(from var(--base-color) calc(l + 0.14) calc(c * 0.5) h)",
  "palette-400": "oklch(from var(--base-color) calc(l + 0.07) calc(c * 0.75) h)",
  "palette-500": "var(--base-color)",
  "palette-600": "oklch(from var(--base-color) calc(l - 0.07) calc(c * 0.95) h)",
  "palette-700": "oklch(from var(--base-color) calc(l - 0.14) calc(c * 0.9) h)",
  "palette-800": "oklch(from var(--base-color) calc(l - 0.22) calc(c * 0.8) h)",
  "palette-900": "oklch(from var(--base-color) calc(l - 0.3) calc(c * 0.68) h)",
  "palette-950": "oklch(from var(--base-color) calc(l - 0.36) calc(c * 0.58) h)",

  "background": "var(--palette-50)",
  "foreground": "var(--palette-950)",
  "card": "var(--palette-50)",
  "card-foreground": "var(--palette-950)",
  "popover": "var(--palette-50)",
  "popover-foreground": "var(--palette-950)",
  "primary": "var(--palette-700)",
  "primary-foreground": "var(--palette-50)",
  "secondary": "var(--palette-100)",
  "secondary-foreground": "var(--palette-900)",
  "muted": "var(--palette-100)",
  "muted-foreground": "var(--palette-600)",
  "accent": "var(--palette-200)",
  "accent-foreground": "var(--palette-900)",
  "destructive": "oklch(from var(--palette-600) l c calc(h - 120))",
  "destructive-foreground": "var(--palette-50)",
  "warning": "oklch(from var(--palette-500) l c calc(h - 70))",
  "warning-foreground": "var(--palette-950)",
  "success": "oklch(from var(--palette-600) l c calc(h + 110))",
  "success-foreground": "var(--palette-50)",
  "info": "oklch(from var(--palette-600) l c calc(h + 25))",
  "info-foreground": "var(--palette-50)",
  "brand": "var(--palette-600)",
  "brand-foreground": "var(--palette-50)",
  "border": "var(--palette-200)",
  "input": "var(--palette-200)",
  "ring": "var(--palette-500)",
  "chart-1": "var(--primary)",
  "chart-2": "var(--info)",
  "chart-3": "var(--success)",
  "chart-4": "var(--warning)",
  "chart-5": "var(--destructive)",
  "sidebar": "var(--palette-50)",
  "sidebar-foreground": "var(--palette-950)",
  "sidebar-primary": "var(--palette-700)",
  "sidebar-primary-foreground": "var(--palette-50)",
  "sidebar-accent": "var(--palette-100)",
  "sidebar-accent-foreground": "var(--palette-900)",
  "sidebar-border": "var(--palette-200)",
  "sidebar-ring": "var(--palette-500)"
}
