{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuumi.local/theme-editor.schema.json",
  "title": "Theme Editor Form",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseColor",
    "radius",
    "lightBackground",
    "lightForeground",
    "lightPrimary",
    "lightRing",
    "darkBackground",
    "darkForeground",
    "darkPrimary",
    "darkRing"
  ],
  "properties": {
    "baseColor": {
      "type": "string",
      "description": "基础色（驱动 light/dark 色带）",
      "minLength": 1
    },
    "radius": {
      "type": "string",
      "description": "基础圆角变量值，例如 0.625rem",
      "minLength": 1
    },
    "lightBackground": {
      "type": "string",
      "description": "浅色模式 background token",
      "minLength": 1
    },
    "lightForeground": {
      "type": "string",
      "description": "浅色模式 foreground token",
      "minLength": 1
    },
    "lightPrimary": {
      "type": "string",
      "description": "浅色模式 primary token",
      "minLength": 1
    },
    "lightRing": {
      "type": "string",
      "description": "浅色模式 ring token",
      "minLength": 1
    },
    "darkBackground": {
      "type": "string",
      "description": "深色模式 background token",
      "minLength": 1
    },
    "darkForeground": {
      "type": "string",
      "description": "深色模式 foreground token",
      "minLength": 1
    },
    "darkPrimary": {
      "type": "string",
      "description": "深色模式 primary token",
      "minLength": 1
    },
    "darkRing": {
      "type": "string",
      "description": "深色模式 ring token",
      "minLength": 1
    }
  }
}
